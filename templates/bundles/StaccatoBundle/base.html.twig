{# Copy of @Staccato/base.html.twig with analytics, social metadata, a favicon and site navigation added. #}
<!DOCTYPE html>
<html lang="{{ staccato.language }}">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-180D4MRYND"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-180D4MRYND');
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ siteTitle }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ staccato.description }}{% endblock %}">
    {% block canonical %}{% endblock %}
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:type" content="{{ page is defined and page.publishedAt ? 'article' : 'website' }}">
    {% if page is defined %}
    <meta property="og:url" content="{{ staccato_url(page.urlPath) }}">
    {% endif %}
    <link rel="icon" href="{{ staccato_path('/assets/favicon.ico') }}">
    <link rel="alternate" type="application/rss+xml" title="{{ siteTitle }}" href="{{ staccato_url('/rss.xml') }}">
    {% if includeDefaultStyles %}
    <link rel="stylesheet" href="{{ staccato_path('/assets/staccato/staccato.css') }}">
    {% endif %}
    {% if includeHighlighterStyles %}
    <link rel="stylesheet" href="{{ staccato_path('/assets/staccato/highlighter.css') }}">
    {% endif %}
    {% for stylesheet in stylesheets %}
    <link rel="stylesheet" href="{{ staccato_path('/assets/staccato/' ~ stylesheet) }}">
    {% endfor %}
</head>
<body>
    <header class="site-header">
        <div class="site-container site-header-inner">
            <a class="site-title" href="{{ staccato_path('/') }}" title="{{ siteTitle }} home">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M8.646 5.646a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1 0 .708l-2 2a.5.5 0 0 1-.708-.708L10.293 8 8.646 6.354a.5.5 0 0 1 0-.708zm-1.292 0a.5.5 0 0 0-.708 0l-2 2a.5.5 0 0 0 0 .708l2 2a.5.5 0 0 0 .708-.708L5.707 8l1.647-1.646a.5.5 0 0 0 0-.708z"/>
                    <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2z"/>
                    <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1H1z"/>
                </svg>
                <span>~/cristian.radulescu/dev-notes</span>
            </a>
            <nav class="site-nav" aria-label="Main">
                <a href="{{ staccato_path('/about/') }}">About</a>
                <a href="{{ staccato_path('/rss.xml') }}">RSS</a>
            </nav>
        </div>
    </header>

    <main class="site-main">
        <div class="site-container">
            {% block content %}{% endblock %}
        </div>
    </main>

    <footer class="site-footer">
        <div class="site-container">
            <p>Built with <a href="https://github.com/cristianradulescu/staccato-bundle">Staccato</a>.</p>
        </div>
    </footer>
</body>
</html>
